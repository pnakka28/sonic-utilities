#!/usr/bin/env python3

import os
import sys
from datetime import datetime

from natsort import natsorted
from tabulate import tabulate

# mock the redis for unit test purposes #
try:
    if os.environ["UTILITIES_UNIT_TESTING"] == "1":
        modules_path = os.path.join(os.path.dirname(__file__), "..")
        tests_path = os.path.join(modules_path, "tests")
        sys.path.insert(0, modules_path)
        sys.path.insert(0, tests_path)
        import mock_tables.dbconnector
        if os.environ.get("UTILITIES_UNIT_TESTING_TOPOLOGY", "") == "multi_asic":
            import mock_tables.mock_multi_asic
            mock_tables.dbconnector.load_namespace_config()
        client = mock_tables.dbconnector.redis.StrictRedis()
        if client.keys() is None:
            raise Exception("Invalid mock_table keys")
except KeyError:
    pass

from sonic_py_common import multi_asic
from swsscommon.swsscommon import SonicV2Connector
from utilities_common import constants
from utilities_common import multi_asic as multi_asic_util
from utilities_common.general import load_db_config


# ========================== Common gearbox-utils logic ==========================

GEARBOX_TABLE_PHY_PREFIX = "_GEARBOX_TABLE:phy:{}"
GEARBOX_TABLE_INTERFACE_PREFIX = "_GEARBOX_TABLE:interface:{}"
GEARBOX_TABLE_PORT_PREFIX = "_GEARBOX_TABLE:phy:{}:ports:{}"

PORT_TABLE_ETHERNET_PREFIX = "PORT_TABLE:{}"

PHY_NAME = "name"
PHY_ID = "phy_id"
PHY_FIRMWARE_MAJOR_VERSION = "firmware_major_version"
PHY_LINE_LANES = "line_lanes"
PHY_SYSTEM_LANES = "system_lanes"

PORT_OPER_STATUS = "oper_status"
PORT_SYSTEM_OPER_STATUS = "system_oper_status"
PORT_LINE_OPER_STATUS = "line_oper_status"
PORT_ADMIN_STATUS = "admin_status"
PORT_SYSTEM_SPEED = "system_speed"
PORT_LINE_SPEED = "line_speed"

INTF_NAME = "name"
INTF_LANES = "lanes"
INTF_SPEED = "speed"

def get_appl_key_attr(db, key, attr, lane_count=1):
    """
    Get APPL_DB key attribute
    """

    val = db.get(db.APPL_DB, key, attr)
    if val is None:
        return "N/A"

    if "speed" in attr:
        if val == "0":
            return "N/A"

        speed = int(val[:-3])

        if (speed % lane_count == 0):
            speed = speed // lane_count
        else:
            return "N/A"
            
        val = '{}G'.format(str(speed))

    return val


def connect_db(namespace, db_name):
    """
    Connect to db_name in the given namespace.
    Returns None if the namespace does not define the DB or its DB is unreachable,
    so that one unavailable ASIC does not hide the gearbox data of the others.
    """
    try:
        db = SonicV2Connector(use_unix_socket_path=False, namespace=namespace)
        if db_name not in db.get_db_list():
            return None
        db.connect(db_name)
        return db
    except Exception as e:
        print(f"Warning: failed to connect to {db_name} in namespace '{namespace}': {e}", file=sys.stderr)
        return None


def db_connect_appl(namespace=constants.DEFAULT_NAMESPACE):
    return connect_db(namespace, 'APPL_DB')

def db_connect_state():
    """
    Connect to REDIS STATE DB and get optics info
    """
    state_db = SonicV2Connector(use_unix_socket_path=False)
    if state_db is None:
        return None
    state_db.connect(state_db.STATE_DB, False)   # Make one attempt only
    return state_db

def appl_db_keys_get(appl_db):
    """
    Get APPL_DB Keys
    """
    return appl_db.keys(appl_db.APPL_DB, GEARBOX_TABLE_PHY_PREFIX.format("*"))

def appl_db_interface_keys_get(appl_db):
    """
    Get APPL_DB Keys
    """
    return appl_db.keys(appl_db.APPL_DB, GEARBOX_TABLE_INTERFACE_PREFIX.format("*"))


def get_namespace_list(namespace=None):
    """
    Get the namespaces to read gearbox data. On multi-ASIC this is every front-end and
    back-end ASIC namespace (gearbox PHYs are never attached to fabric ASICs)
    """
    ns_list = multi_asic_util.MultiAsic(constants.DISPLAY_ALL, namespace).get_ns_list_based_on_options()
    if namespace is None and multi_asic.is_multi_asic():
        fabric_namespaces = multi_asic.get_all_namespaces()['fabric_ns']
        ns_list = [ns for ns in ns_list if ns not in fabric_namespaces]
    return ns_list


def resolve_namespaces(namespaces=None, show_asic=None):
    """
    Default to all namespaces, and add the ASIC column only on multi-ASIC platforms
    """
    if namespaces is None:
        namespaces = get_namespace_list()
    if show_asic is None:
        show_asic = multi_asic.is_multi_asic()
    return namespaces, show_asic


def format_ber(value):
    """
    Format BER value to scientific notation with 2 decimal places
    Args:
        value: String or numeric BER value
    Returns:
        Formatted string like "6.05e-10" or "N/A"
    """
    if value == 'N/A' or value == '-1':
        return value

    try:
        num_value = float(value)
        if num_value == 0:
            return "0.00e+00"
        # Format with 2 decimal places in scientific notation
        return f"{num_value:.2e}"
    except (ValueError, TypeError):
        return value

def format_number_with_commas(value):
    """
    Format numeric value with comma separators
    Args:
        value: String or numeric value
    Returns:
        Formatted string like "219,033,232,324"
    """
    try:
        num_value = int(value)
        return f"{num_value:,}"
    except (ValueError, TypeError):
        return value

# ========================== phy-status logic ==========================

phy_header_status = ['PHY Id', 'Name', 'Firmware']

class PhyStatus(object):

    def get_phy_status_rows(self, appl_db, appl_db_keys):
        """
        Generate phy status rows for one namespace
        """
        table = []

        for key in appl_db_keys:
            if 'lanes' in key or 'ports' in key:
                continue
            list_items = key.split(':')
            phy_id = list_items[2]
            data_row = (
                phy_id,
                get_appl_key_attr(appl_db, GEARBOX_TABLE_PHY_PREFIX.format(phy_id), PHY_NAME),
                get_appl_key_attr(appl_db, GEARBOX_TABLE_PHY_PREFIX.format(phy_id), PHY_FIRMWARE_MAJOR_VERSION))
            table.append(data_row)

        return table

    def __init__(self, namespaces=None, show_asic=None):
        namespaces, show_asic = resolve_namespaces(namespaces, show_asic)

        table = []
        for namespace in namespaces:
            appl_db = db_connect_appl(namespace)
            if appl_db is None:
                continue
            appl_db_keys = appl_db_keys_get(appl_db)
            if not appl_db_keys:
                continue
            for row in self.get_phy_status_rows(appl_db, appl_db_keys):
                # PHY ids are only unique within an ASIC
                table.append((namespace,) + row if show_asic else row)

        header = ['ASIC'] + phy_header_status if show_asic else phy_header_status

        # Sorting and tabulating the result table.
        sorted_table = natsorted(table)
        print(tabulate(sorted_table, header, tablefmt="simple", stralign='right'))

# ========================== interface-status logic ==========================

intf_header_status = ['PHY Id', 'Interface', 'MAC Lanes', 'MAC Lane Speed', 'PHY Lanes', 'PHY Lane Speed', 'Line Lanes', 'Line Lane Speed', 'Oper', 'Admin']

class InterfaceStatus(object):

    def get_intf_status_rows(self, appl_db, appl_db_keys):
        """
        Generate interface status rows for one namespace
        """
        table = []

        for key in appl_db_keys:
            list_items = key.split(':')
            index = list_items[2]

            name = get_appl_key_attr(appl_db, GEARBOX_TABLE_INTERFACE_PREFIX.format(index), INTF_NAME)

            mac_lanes = get_appl_key_attr(appl_db, PORT_TABLE_ETHERNET_PREFIX.format(name), INTF_LANES)
            lane_count = len(mac_lanes.split(','))

            phy_id = get_appl_key_attr(appl_db, GEARBOX_TABLE_INTERFACE_PREFIX.format(index), PHY_ID)

            data_row = (
                phy_id,
                name,
                mac_lanes,
                get_appl_key_attr(appl_db, PORT_TABLE_ETHERNET_PREFIX.format(name), INTF_SPEED, lane_count),
                get_appl_key_attr(appl_db, GEARBOX_TABLE_INTERFACE_PREFIX.format(index), PHY_SYSTEM_LANES),
                get_appl_key_attr(appl_db, GEARBOX_TABLE_PORT_PREFIX.format(phy_id, index), PORT_SYSTEM_SPEED),
                get_appl_key_attr(appl_db, GEARBOX_TABLE_INTERFACE_PREFIX.format(index), PHY_LINE_LANES),
                get_appl_key_attr(appl_db, GEARBOX_TABLE_PORT_PREFIX.format(phy_id, index), PORT_LINE_SPEED),
                get_appl_key_attr(appl_db, PORT_TABLE_ETHERNET_PREFIX.format(name), PORT_OPER_STATUS),
                get_appl_key_attr(appl_db, PORT_TABLE_ETHERNET_PREFIX.format(name), PORT_ADMIN_STATUS))

            table.append(data_row)

        return table

    def __init__(self, namespaces=None, show_asic=None):
        namespaces, show_asic = resolve_namespaces(namespaces, show_asic)

        table = []
        for namespace in namespaces:
            appl_db = db_connect_appl(namespace)
            if appl_db is None:
                continue
            appl_db_keys = appl_db_interface_keys_get(appl_db)
            if not appl_db_keys:
                continue
            for row in self.get_intf_status_rows(appl_db, appl_db_keys):
                table.append((namespace,) + row if show_asic else row)

        header = ['ASIC'] + intf_header_status if show_asic else intf_header_status

        # Sorting and tabulating the result table.
        sorted_table = natsorted(table)
        print(tabulate(sorted_table, header, tablefmt="simple", stralign='right'))

# ========================== interfaces-fec logic ==========================

COUNTERS_PORT_NAME_MAP = "COUNTERS_PORT_NAME_MAP"
GB_COUNTERS_DB = "GB_COUNTERS_DB"
COUNTER_TABLE_PREFIX = "COUNTERS:"
RATES_TABLE_PREFIX = "RATES:"

# FEC Histogram bins (S0-S15)
FEC_HISTOGRAM_BINS = [f"SAI_PORT_STAT_IF_IN_FEC_CODEWORD_ERRORS_S{i}" for i in range(16)]

# FEC Histogram timestamp format
FEC_HISTOGRAM_TS_FORMAT = "%Y-%m-%d %H:%M:%S"

class InterfaceFecStats(object):

    def __init__(self, port_name=None, display_type='stats', namespaces=None, show_asic=None):
        """
        Initialize and display FEC information
        Args:
            port_name: Optional port name to filter (e.g., "Ethernet0")
                      If None, display for all ports
            display_type: 'histogram' or 'stats'
            namespaces: Optional list of namespaces to read; all namespaces if None
            show_asic: Add the ASIC column; defaults to True on multi-ASIC platforms
        """
        self.port_name = port_name
        self.display_type = display_type
        self.namespaces, self.show_asic = resolve_namespaces(namespaces, show_asic)
        self.gb_dbs = {}
        self.appl_dbs = {}

        for namespace in self.namespaces:
            gb_db = connect_db(namespace, GB_COUNTERS_DB)
            appl_db = db_connect_appl(namespace) if gb_db is not None else None
            if appl_db is None:
                continue
            self.gb_dbs[namespace] = gb_db
            self.appl_dbs[namespace] = appl_db

        if display_type == 'histogram':
            self.display_fec_histogram()
        elif display_type == 'stats':
            self.display_fec_stats()

    def get_port_name_map(self, namespace):
        """
        Get the port name to OID mapping from GB_COUNTERS_DB
        """
        port_name_map = self.gb_dbs[namespace].get_all(GB_COUNTERS_DB, COUNTERS_PORT_NAME_MAP)
        return port_name_map if port_name_map else {}

    def get_counters_for_oid(self, namespace, oid):
        """
        Get all counters for a specific OID
        """
        full_table_id = COUNTER_TABLE_PREFIX + oid
        counters = self.gb_dbs[namespace].get_all(GB_COUNTERS_DB, full_table_id)
        return counters if counters else {}

    def get_rates_for_oid(self, namespace, oid):
        """
        Get all rates for a specific OID
        """
        full_table_id = RATES_TABLE_PREFIX + oid
        rates = self.gb_dbs[namespace].get_all(GB_COUNTERS_DB, full_table_id)
        return rates if rates else {}

    def get_port_state(self, namespace, base_port_name, side):
        """
        Get port operational state from APPL_DB
        """
        appl_db = self.appl_dbs[namespace]
        port_key = PORT_TABLE_ETHERNET_PREFIX.format(base_port_name)
        attr = PORT_SYSTEM_OPER_STATUS if side == 'System' else PORT_LINE_OPER_STATUS
        oper_status = appl_db.get(appl_db.APPL_DB, port_key, attr)
        if oper_status and oper_status.lower() == 'up':
            return 'U'
        elif oper_status and oper_status.lower() == 'down':
            return 'D'
        else:
            return 'N/A'

    def get_matching_ports(self):
        """
        Get ports to display based on port_name filter
        Returns dict of {(namespace, port_name): oid}
        """
        port_name_maps = {namespace: self.get_port_name_map(namespace) for namespace in self.gb_dbs}

        if not any(port_name_maps.values()):
            print("Error: No port name mapping found in GB_COUNTERS_DB")
            return None

        matching_ports = {}
        for namespace, port_name_map in port_name_maps.items():
            for full_port_name, oid in port_name_map.items():
                # If specific port requested, filter to that port (both line and system)
                if self.port_name and not (full_port_name.startswith(f"{self.port_name}_") and
                                           (full_port_name.endswith("_line") or full_port_name.endswith("_system"))):
                    continue
                matching_ports[(namespace, full_port_name)] = oid

        if self.port_name and not matching_ports:
            print(f"Error: Port '{self.port_name}' not found in GB_COUNTERS_DB")
            base_ports = set()
            for port_name_map in port_name_maps.values():
                for port in port_name_map.keys():
                    if port.endswith('_line'):
                        base_ports.add(port[:-5])
                    elif port.endswith('_system'):
                        base_ports.add(port[:-7])
            print(f"Available ports: {', '.join(natsorted(base_ports))}")
            return None
        return matching_ports

    def extract_port_info(self, port_name):
        """
        Extract base name and side from port name
        Returns tuple: (base_name, side)
        """
        if port_name.endswith('_line'):
            return port_name[:-5], 'Line'
        elif port_name.endswith('_system'):
            return port_name[:-7], 'System'
        else:
            return port_name, ''

    def display_histogram_for_port(self, counters, port_name, namespace=constants.DEFAULT_NAMESPACE):
        """
        Display FEC codeword error histogram for a port
        """
        base_name, side = self.extract_port_info(port_name)

        title = f"{base_name} {side}"
        if self.show_asic:
            title += f" ({namespace})"
        print(f"\n{title}")
        
        # Display histogram bins
        histogram_data = []
        for i, bin_name in enumerate(FEC_HISTOGRAM_BINS):
            value = counters.get(bin_name, '0')

            timestamp_ms = counters.get(f'{bin_name}_TIMESTAMP')
            try:
                ts_ms = int(timestamp_ms)
                if ts_ms > 0:
                    ts_sec = ts_ms / 1000.0
                    timestamp_str = datetime.fromtimestamp(ts_sec).strftime(FEC_HISTOGRAM_TS_FORMAT)
                else:
                    timestamp_str = 'N/A'
            except (TypeError, ValueError, OSError, OverflowError):
                timestamp_str = 'N/A'

            histogram_data.append([f'BIN{i}', value, timestamp_str])
        
        if histogram_data:
            print(tabulate(histogram_data, headers=['Symbol Errors Per Codeword', 'Codewords', 'Last Updated'], tablefmt='simple'))

    def display_fec_histogram(self):
        """
        Display FEC histogram from GB_COUNTERS_DB
        """
        try:
            ports_to_display = self.get_matching_ports()
            if ports_to_display is None:
                return
            
            # Display histogram for each port
            for namespace, port_name in natsorted(ports_to_display.keys()):
                oid = ports_to_display[(namespace, port_name)]
                counters = self.get_counters_for_oid(namespace, oid)

                if counters:
                    self.display_histogram_for_port(counters, port_name, namespace)
                else:
                    print(f"\n{port_name} ({namespace})" if self.show_asic else f"\n{port_name}")
                    print("No counter data available")
                    
        except Exception as e:
            print(f"Error displaying FEC histogram: {e}")

    def display_fec_stats(self):
        """
        Display FEC stats from GB_COUNTERS_DB
        """
        try:
            ports_to_display = self.get_matching_ports()
            if ports_to_display is None:
                return
            
            # Collect stats for each port
            table_data = []
            for namespace, port_name in natsorted(ports_to_display.keys()):
                oid = ports_to_display[(namespace, port_name)]
                counters = self.get_counters_for_oid(namespace, oid)
                rates = self.get_rates_for_oid(namespace, oid)

                base_name, side = self.extract_port_info(port_name)

                iface = f"{base_name} {side}"
                state = self.get_port_state(namespace, base_name, side)

                # Get counter values and format with commas
                fec_corr = format_number_with_commas(counters.get('SAI_PORT_STAT_IF_IN_FEC_CORRECTABLE_FRAMES', '0'))
                fec_uncorr = format_number_with_commas(counters.get('SAI_PORT_STAT_IF_IN_FEC_NOT_CORRECTABLE_FRAMES', '0'))
                fec_symbol_err = format_number_with_commas(counters.get('SAI_PORT_STAT_IF_IN_FEC_SYMBOL_ERRORS', '0'))

                # Format BER values with 2 decimal places
                fec_pre_ber = format_ber(rates.get('FEC_PRE_BER', '0'))
                fec_post_ber = format_ber(rates.get('FEC_POST_BER', '0'))
                fec_pre_ber_max = format_ber(rates.get('FEC_PRE_BER_MAX', 'N/A'))
                fec_max_t = rates.get('FEC_MAX_T', '-1')

                row = [
                    iface,
                    state,
                    fec_corr,
                    fec_uncorr,
                    fec_symbol_err,
                    fec_pre_ber,
                    fec_post_ber,
                    fec_pre_ber_max,
                    fec_max_t
                ]
                table_data.append([namespace] + row if self.show_asic else row)
            
            # Display table with proper alignment
            headers = ['GB IFACE', 'STATE', 'FEC_CORR', 'FEC_UNCORR', 'FEC_SYMBOL_ERR',
                      'FEC_PRE_BER', 'FEC_POST_BER', 'FEC_PRE_BER_MAX', 'FEC_MAX_T']

            # Use 'simple' format with mixed alignment: left for GB IFACE, right for others
            # colalign specifies alignment per column
            colalign = ('left', 'right', 'right', 'right', 'right', 'right', 'right', 'right', 'right')
            if self.show_asic:
                headers = ['ASIC'] + headers
                colalign = ('left',) + colalign
            print(tabulate(table_data, headers=headers, tablefmt='simple', colalign=colalign))
                    
        except Exception as e:
            print(f"Error displaying FEC stats: {e}")
            import traceback
            traceback.print_exc()


def parse_namespace_option(args):
    """
    Extract the optional -n/--namespace <namespace> option from the arguments
    Returns tuple: (namespace, remaining_args)
    """
    namespace = None
    remaining_args = []
    i = 0
    while i < len(args):
        if args[i] in ('-n', '--namespace'):
            if i + 1 >= len(args):
                print("Error: -n/--namespace requires a namespace name")
                sys.exit(1)
            namespace = args[i + 1]
            i += 2
        else:
            remaining_args.append(args[i])
            i += 1
    return namespace, remaining_args


def main(args):
    """
    Usage:
        gearboxutil [-n <namespace>] phys status
        gearboxutil [-n <namespace>] interfaces status
        gearboxutil [-n <namespace>] interfaces fec-histogram [<port_name>]
        gearboxutil [-n <namespace>] interfaces fec-stats [<port_name>]

    On multi-ASIC platforms all namespaces are displayed, with an ASIC column,
    unless -n/--namespace selects one.

    Examples:
        gearboxutil interfaces fec-histogram                # Show histogram for all ports
        gearboxutil interfaces fec-histogram Ethernet0      # Show histogram for Ethernet0 (line and system)
        gearboxutil interfaces fec-stats                    # Show FEC stats for all ports
        gearboxutil interfaces fec-stats Ethernet0          # Show FEC stats for Ethernet0 (line and system)
        gearboxutil -n asic0 interfaces fec-stats           # Show FEC stats for all ports in asic0
    """

    namespace, args = parse_namespace_option(args)

    if len(args) == 0:
        print("No valid arguments provided")
        print(main.__doc__)
        return

    cmd1 = args[0]
    if cmd1 != "phys" and cmd1 != "interfaces":
        print("No valid command provided")
        print(main.__doc__)
        return

    if len(args) < 2:
        print("No valid command provided")
        print(main.__doc__)
        return

    cmd2 = args[1]
    if cmd2 not in ["status", "fec-histogram", "fec-stats"]:
        print("No valid command provided")
        print(main.__doc__)
        return

    try:
        namespaces = get_namespace_list(namespace)
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)

    if cmd1 == "phys" and cmd2 == "status":
        PhyStatus(namespaces)
    elif cmd1 == "interfaces" and cmd2 == "status":
        InterfaceStatus(namespaces)
    elif cmd1 == "interfaces" and cmd2 == "fec-histogram":
        # Optional port name parameter
        port_name = args[2] if len(args) > 2 else None
        InterfaceFecStats(port_name, display_type='histogram', namespaces=namespaces)
    elif cmd1 == "interfaces" and cmd2 == "fec-stats":
        # Optional port name parameter
        port_name = args[2] if len(args) > 2 else None
        InterfaceFecStats(port_name, display_type='stats', namespaces=namespaces)

    sys.exit(0)

if __name__ == "__main__":
    load_db_config()
    main(sys.argv[1:])
